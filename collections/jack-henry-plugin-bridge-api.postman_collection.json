          "name": "Exchange Bridge Token",
          "request": {
            "name": "Exchange Bridge Token",
            "description": {
              "content": "Exchanges the parent-window handshake nonce for a short-lived\nbridge token used by the @jack-henry/banno-plugin-framework-bridge\nlibrary to call host-side functions.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "plugins",
                "api",
                "v0",
                "plugins",
                ":pluginId",
                "bridge",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "pluginId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nonce\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
